{
	"name": "dsh-custom-desktop",
	"description": "Desktop-only DSH composer customization: hover model and effort menus, plus configurable native commands to cycle reasoning effort and open the model picker. Vendored from the desktop 0.2.1-rc.2 build.",
	"version": "0.2.0",
	"type": "module",
	"main": "./index.mjs",
	"exports": {
		".": "./index.mjs",
		"./client": "./client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"index.mjs",
		"client.js",
		"cordis.patch.yml",
		"README.md"
	],
	"scripts": {
		"test": "node check-client.mjs"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-ui-model-selection",
				"@deepseek-ai/dsh-api-session-controller"
			]
		}
	},
	"keywords": [
		"deepseek-harness",
		"dsh",
		"plugin",
		"custom-ui",
		"model-select",
		"hover",
		"desktop"
	],
	"license": "MIT"
}
