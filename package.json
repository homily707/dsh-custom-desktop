{
	"name": "dsh-custom-desktop",
	"description": "Desktop-only DSH composer customization and per-session prefix cache keepalive via /cache slash command. Persist per-keepalive cache usage stats.",
	"version": "0.4.0",
	"type": "module",
	"main": "./index.mjs",
	"exports": {
		".": "./index.mjs",
		"./client": "./client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"index.mjs",
		"cache-keepalive.mjs",
		"cache-stats.mjs",
		"client.js",
		"cordis.patch.yml",
		"README.md"
	],
	"scripts": {
		"test": "node check-client.mjs && node check-host.mjs && node check-cache-stats.mjs"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-ui-model-selection",
				"@deepseek-ai/dsh-api-session-controller"
			]
		}
	},
	"keywords": [
		"deepseek-harness",
		"dsh",
		"plugin",
		"custom-ui",
		"model-select",
		"hover",
		"desktop"
	],
	"license": "MIT"
}
