{
	"name": "dsh-custom-desktop",
	"description": "Desktop DSH plugin: hover model/effort menus, configurable shortcuts, and safe permanent session deletion from the native context menu.",
	"version": "0.3.0",
	"type": "module",
	"main": "./index.mjs",
	"exports": {
		".": "./index.mjs",
		"./client": "./client.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"index.mjs",
		"session-delete.host.mjs",
		"client.js",
		"cordis.patch.yml",
		"README.md"
	],
	"scripts": {
		"test": "node check-client.mjs"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-ui-model-selection",
				"@deepseek-ai/dsh-api-session-controller",
				"@deepseek-ai/dsh-client-ui-context-menu"
			]
		}
	},
	"keywords": [
		"deepseek-harness",
		"dsh",
		"plugin",
		"custom-ui",
		"model-select",
		"hover",
		"desktop",
		"session-delete"
	],
	"license": "MIT"
}
